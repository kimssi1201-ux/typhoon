---
import SupportProgramCard from "./SupportProgramCard.astro";

type SupportProgram = {
  slug: string;
  href: string;
  title: string;
  description: string;
  category: string;
  target: string;
  amount: string;
  period: string;
  status: string;
  regions: string[];
  fields: string[];
  ageGroups: string[];
  updatedLabel: string;
  searchText: string;
  tile?: {
    label: string;
    html: string;
    style: string;
  };
};

interface Props {
  programs: SupportProgram[];
}

const { programs } = Astro.props as Props;
const categoryTabs = [
  { label: "전체", audience: "전체", field: "전체" },
  { label: "청년", audience: "청년", field: "전체" },
  { label: "육아·가정", audience: "전체", field: "출산 / 육아" },
  { label: "소상공인", audience: "소상공인", field: "소상공인" },
  { label: "고용·취업", audience: "전체", field: "취업 / 구직" },
  { label: "생활·에너지", audience: "전체", field: "생활비" },
  { label: "세금·환급", audience: "전체", field: "기타" }
];
---

<section class="support-section support-finder" id="support-finder" aria-labelledby="support-finder-title" data-support-list data-reveal>
  <div class="support-section-head">
    <p>지원금 목록</p>
    <h2 id="support-finder-title">선택한 조건에 맞는 지원금</h2>
    <span>위에서 고른 조건을 기준으로 기존 지원금 글을 바로 좁혀 보여줍니다.</span>
  </div>

  <div class="support-list-panel">
    <div class="support-category-tabs" role="tablist" aria-label="지원금 분야">
      {categoryTabs.map((tab) => (
        <button
          type="button"
          role="tab"
          aria-selected={tab.label === "전체" ? "true" : "false"}
          data-support-tab
          data-audience={tab.audience}
          data-field={tab.field}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="support-list-tools">
      <form class="support-main-search" action="/support#support-results" method="get" role="search" data-support-main-search>
        <label for="support-query">키워드 검색</label>
        <div>
          <input id="support-query" type="search" name="q" maxlength="40" placeholder="청년월세, 근로장려금, 부모급여, 소상공인" data-support-query />
          <button type="submit">검색</button>
        </div>
      </form>

      <div class="support-filter-summary">
        <p data-support-list-status aria-live="polite">전체 {programs.length}개 지원금을 표시 중입니다.</p>
        <button type="button" data-support-reset>조건 초기화</button>
      </div>
    </div>
  </div>

  <div class="support-results" id="support-results" data-support-results>
    {programs.map((program, index) => <SupportProgramCard program={program} index={index} />)}
  </div>

  <div class="support-empty" data-support-empty hidden>
    <h3>조건에 맞는 지원금을 찾지 못했습니다.</h3>
    <p>다른 조건을 선택하거나 전체 지원금 목록을 확인해보세요.</p>
    <div>
      <button type="button" data-support-reset>조건 초기화</button>
      <a href="/지원금">전체 지원금 보기</a>
    </div>
  </div>
</section>
