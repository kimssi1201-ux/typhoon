---
import { formatDateDots, stripHtml, supportBenefit, supportPeriod } from "../lib/content.js";

const { post, anchorId = "" } = Astro.props;
const data = post.data;
const href = `/${data.slug}`;
const benefit = supportBenefit(post);
const period = supportPeriod(post);
const titleId = `post-card-${data.slug}`;
const searchText = stripHtml([data.title, data.summary, data.category, data.slug, benefit, period].filter(Boolean).join(" "));
---

<article class="post-card" id={anchorId || undefined} data-post={data.slug} data-category={data.categoryId} data-search-text={searchText}>
  <a class="post-card-link" href={href} aria-labelledby={titleId}>
    <div class="post-card-content">
      <p class="entry-meta">
        <span class="category-chip">{data.category}</span>
        <span>·</span>
        <span>최종 확인 {formatDateDots(data.dateModified)}</span>
      </p>
      <h2 class="entry-title" id={titleId}>{data.title}</h2>
      <p class="entry-summary">{benefit}</p>
      <dl class="post-card-facts">
        {period && <div><dt>신청기간</dt><dd>{period}</dd></div>}
        <div><dt>신청정보</dt><dd>공식 공고 확인</dd></div>
      </dl>
    </div>
  </a>
</article>
