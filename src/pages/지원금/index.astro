---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import SupportSearch from "../../components/SupportSearch.astro";
import { CATEGORIES, SITE } from "../../data/site.js";
import { archivePosts, categoryCounts, postsByCategory } from "../../lib/content.js";
import { supportJsonLd } from "../../lib/seo.js";

const posts = archivePosts(await getCollection("posts"));
const grouped = postsByCategory(posts);
const counts = categoryCounts(posts);
const firstPostByCategory = new Map(grouped.map((category) => [category.id, category.posts[0]?.data.slug]));
---

<BaseLayout
  title="지원금 전체 글 | 복지모음집"
  description="복지모음집의 지원금 글 전체 목록입니다. 소상공인, 육아·출산, 고용·취업, 생활·에너지, 세금·환급 카테고리별로 확인하세요."
  canonicalPath="/지원금"
  ogType="website"
  ogTitle="지원금 전체 글 | 복지모음집"
  ogDescription="카테고리별로 확인하는 정부지원금 글 전체 목록"
  ogImage={SITE.defaultImage}
  twitterCard="summary_large_image"
  bodyClass="blog-page archive support-archive generatepress-style"
  activeNav="support"
  cssHref="/blog.css?v=20260904-info-service1"
  scripts={["/support-search.js"]}
  themeColor={SITE.themeColor}
  jsonLd={supportJsonLd}
>
  <main class="site-main" id="main" data-post-count={posts.length}>
    <div class="site-grid support-portal-grid">
      <section class="content-area support-portal-content" aria-labelledby="archive-title">
        <header class="archive-title" id="support-category">
          <h1 id="archive-title">지원금</h1>
          <p class="archive-intro">지원 대상, 혜택, 신청기간과 공식 확인처를 비교해서 필요한 글을 고를 수 있습니다.</p>
          <nav class="category-filter" aria-label="지원금 분야">
            <ul>
              <li><a href="/지원금#support-search">전체 <span>{posts.length}</span></a></li>
              {
                CATEGORIES.map((category) => (
                  <li>
                    <a href={`/지원금#${category.id}`}>{category.label} <span>{counts.get(category.id) || 0}</span></a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <SupportSearch
            id="support-search"
            label="지원금 검색"
            description="대상, 정책명, 혜택 키워드로 빠르게 좁혀보세요."
            placeholder="예: K패스, 청년월세, 부모급여"
            countText={`전체 ${posts.length}개 글을 표시 중입니다.`}
          />
        </header>
        <div class="support-card-grid">
          {
            posts.map((post) => (
              <PostCard
                post={post}
                anchorId={firstPostByCategory.get(post.data.categoryId) === post.data.slug ? post.data.categoryId : ""}
              />
            ))
          }
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
