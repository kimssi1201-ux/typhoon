---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SupportHero from "../components/support/SupportHero.astro";
import SupportFinder from "../components/support/SupportFinder.astro";
import SupportGuide from "../components/support/SupportGuide.astro";
import SupportSourceNotice from "../components/support/SupportSourceNotice.astro";
import SupportMobileCTA from "../components/support/SupportMobileCTA.astro";
import { SITE } from "../data/site.js";
import { popularPosts } from "../lib/content.js";
import { homeJsonLd } from "../lib/seo.js";
import {
  supportProgramsFromPosts,
  toSupportProgram
} from "../lib/support-landing.js";

const posts = await getCollection("posts");
const programs = supportProgramsFromPosts(posts);
const featuredPrograms = popularPosts(posts, 6).map(toSupportProgram);
const activeRegions = new Set(programs.flatMap((program) => program.regions)).size;
const sourceCount = programs.filter((program) => program.sourceLabel).length;
const categoryCount = new Set(programs.map((program) => program.categoryId)).size;
---

<BaseLayout
  title="복지모음집 | 정부지원금 신청 정보 블로그"
  description="정부와 공공기관의 공식 자료를 바탕으로 지원 대상, 금액, 신청 기간과 방법을 정리하는 지원금 정보 블로그입니다."
  canonicalPath="/"
  ogType="website"
  ogTitle="복지모음집 | 정부지원금 신청 정보 블로그"
  ogDescription="공식 신청처와 함께 보는 정부지원금 정보 블로그"
  ogImage={SITE.defaultImage}
  twitterCard="summary_large_image"
  bodyClass="blog-page home support-landing-page generatepress-style"
  activeNav="home"
  cssHref="/blog.css?v=20260905-ai-trust1"
  extraCss={["/support-landing.css?v=20260907-support4"]}
  scripts={["/support-landing.js?v=20260907-support4"]}
  includeRss
  includeNaverVerification
  themeColor={SITE.themeColor}
  jsonLd={homeJsonLd}
>
  <main class="site-main support-landing" id="main" data-support-page data-post-count={programs.length}>
    <SupportHero
      totalCount={programs.length}
      categoryCount={categoryCount}
      regionCount={activeRegions}
      sourceCount={sourceCount}
      programs={programs}
      featuredPrograms={featuredPrograms}
    />
    <SupportFinder programs={programs} />
    <SupportGuide />
    <SupportSourceNotice />
    <section class="support-final-cta" aria-labelledby="home-final-cta-title" data-reveal>
      <p>지원금 전체 목록</p>
      <h2 id="home-final-cta-title">모든 지원금 글은 기존 URL 그대로 확인할 수 있습니다</h2>
      <div>
        <a class="support-primary-cta" href="#support-finder">내 조건으로 찾기<span aria-hidden="true">→</span></a>
        <a class="support-secondary-cta" href="/지원금">전체 지원금 목록</a>
      </div>
    </section>
    <SupportMobileCTA />
  </main>
</BaseLayout>
