---
import BaseLayout from "./BaseLayout.astro";
import BenefitSummary from "../components/BenefitSummary.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE } from "../data/site.js";
import { metaDateHtml, removeFirstKeyFactsHtml } from "../lib/content.js";
import { postJsonLd } from "../lib/seo.js";

const { post, posts } = Astro.props;
const data = post.data;
const articleBodyHtml = removeFirstKeyFactsHtml(data.bodyHtml);
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  canonicalPath={data.canonicalPath}
  ogType="article"
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  ogImage={data.ogImage}
  twitterCard={data.twitterCard}
  bodyClass={data.bodyClass}
  activeNav="support"
  cssHref="/blog.css?v=20260905-benefit-compact1"
  scripts={["/blog.js?v=20260904-toc-simple1", "/coupang-partners.js?v=20260828-coupang3"]}
  themeColor={SITE.themeColor}
  jsonLd={postJsonLd(data)}
>
  <main class="site-main" id="main">
    <div class="site-grid">
      <article class="content-area single-post hentry">
        <nav class="breadcrumbs" aria-label="현재 위치">
          <a href="/">홈</a><span>/</span><a href="/지원금">지원금</a><span>/</span><span aria-current="page">{data.breadcrumbLabel}</span>
        </nav>
        <header class="entry-header">
          <p class="entry-meta">
            <a class="category-chip" href={`/지원금#${data.categoryId}`}>{data.category}</a>
            <span>{metaDateHtml(data)}</span>
          </p>
          <h1>{data.title}</h1>
          <p class="entry-description">{data.entryDescription || data.description}</p>
        </header>
        <BenefitSummary post={post} />
        <section class="article-content" data-post-content data-counted-content set:html={articleBodyHtml}></section>

        <footer class="official-sources" set:html={data.officialSourcesHtml}></footer>
        {
          data.affiliate && (
            <aside
              class="affiliate-widget"
              data-coupang-partners
              data-keyword={data.affiliate.keyword}
              data-title={data.affiliate.title}
              hidden
            >
            </aside>
          )
        }
        <nav class="post-navigation" aria-label="글 이동" set:html={data.postNavigationHtml}></nav>
      </article>

      <Sidebar posts={posts} post={data} />
    </div>
  </main>
</BaseLayout>
